# HomeBudget Configuration

# App Mode & SSO
DEV_MODE=true

# PocketBase Backend Configuration
POCKETBASE_URL=https://pocketbase.office.lab
POCKETBASE_USER=your_user_or_email
POCKETBASE_PASSWORD=your_password
POCKETBASE_COLLECTION=users
PB_VERIFY_SSL=false

# SMTP Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=HomeBudget Notifications <your_email@gmail.com>
NOTIFICATION_EMAIL_TO=recipient@example.com
SMTP_TLS=true
